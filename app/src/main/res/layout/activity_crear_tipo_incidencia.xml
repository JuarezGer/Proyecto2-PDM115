<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_gray_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/bg_labcare_header"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear tipo"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Registro de catálogo de incidencias"
                android:textColor="@color/blue_gray_100"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtMensajeCrearTipoIncidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/blue_gray_700"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del tipo de incidencia"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNombreTipoIncidencia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_labcare_input"
                android:hint="Ej. Hardware"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textColor="@color/blue_gray_900"
                android:textColorHint="@color/blue_gray_400" />

            <Button
                android:id="@+id/btnGuardarTipoIncidencia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/blue_gray_600"
                android:text="Guardar"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLimpiarTipoIncidencia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/blue_gray_500"
                android:text="Limpiar"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVolverCrearTipoIncidencia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_labcare_button_secondary"
                android:text="Volver"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
