<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/bg_labcare_header"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear equipo"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Registro de equipos del laboratorio"
                android:textColor="@color/blue_gray_100"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtMensajeCrearEquipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/blue_gray_700"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Laboratorio -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Laboratorio"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spLaboratorioCrear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Categoría -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Categoría"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spCategoriaCrear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Código inventario -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Código inventario"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtCodigoInventarioCrear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_labcare_input"
                android:padding="12dp" />

            <!-- Código QR -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Código QR"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtCodigoQrCrear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_labcare_input"
                android:padding="12dp" />

            <!-- Nombre -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Nombre"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNombreEquipoCrear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_labcare_input"
                android:padding="12dp" />

            <!-- Marca -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Marca"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtMarcaCrear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_labcare_input"
                android:padding="12dp" />

            <!-- Modelo -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Modelo"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtModeloCrear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_labcare_input"
                android:padding="12dp" />

            <!-- Estado -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Estado"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spEstadoCrear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnGuardarEquipo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_labcare_button_primary"
                android:backgroundTint="@null"
                android:text="Guardar equipo"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLimpiarEquipo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_labcare_button_secondary"
                android:backgroundTint="@null"
                android:text="Limpiar"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVolverCrearEquipo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_labcare_button_secondary"
                android:backgroundTint="@null"
                android:text="Volver"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>