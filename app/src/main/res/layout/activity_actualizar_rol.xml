<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_gray_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:title="Actualizar Rol" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/bg_labcare_header"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualizar rol"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Seleccione un rol y modifique sus datos"
                android:textColor="@color/blue_gray_100"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seleccione el rol"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spRoles"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="ID Rol"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtIdRol"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:enabled="false"
                android:hint="ID bloqueado"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/blue_gray_900"
                android:textColorHint="@color/blue_gray_400" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nuevo nombre"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtNombreRol"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Nombre del rol"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textColor="@color/blue_gray_900"
                android:textColorHint="@color/blue_gray_400" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Descripción"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtDescripcionRol"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Descripción del rol"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="@color/blue_gray_900"
                android:textColorHint="@color/blue_gray_400" />

            <Button
                android:id="@+id/btnActualizarRol"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/blue_gray_600"
                android:text="Actualizar"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLimpiarRol"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/blue_gray_500"
                android:text="Limpiar"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVolverActualizarRol"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_labcare_button_secondary"
                android:text="Volver"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
