<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootServiciosNube"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_gray_50"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Servicios en la nube"
            android:textColor="@color/blue_gray_900"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Guardar y restaurar registros usando XAMPP/MySQL."
            android:textColor="@color/blue_gray_700"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_labcare_card"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/btnVerificarConexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/blue_gray_600"
                android:text="Verificar conexión"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnGuardarServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/blue_gray_600"
                android:text="Guardar registros en servidor"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnRestaurarServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/blue_gray_600"
                android:text="Restaurar registros desde servidor"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/txtEstadoServiciosNube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Estado: pendiente de conexión."
                android:textColor="@color/blue_gray_800"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnVolverServiciosNube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/blue_gray_600"
                android:text="Volver"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
