<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_gray_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/bg_labcare_header"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear incidencia"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Registro manual o por reconocimiento de voz"
                android:textColor="@color/blue_gray_100"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtMensajeCrearIncidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/blue_gray_700"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipo"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spEquipoIncidenciaCrear"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Usuario que reporta"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spUsuarioReportaIncidenciaCrear"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tipo de incidencia"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spTipoIncidenciaCrear"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Título"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTituloIncidenciaCrear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_labcare_input"
                android:hint="Ej. Equipo no enciende"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:textColor="@color/blue_gray_900"
                android:textColorHint="@color/blue_gray_400" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Descripción"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDescripcionIncidenciaCrear"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_labcare_input"
                android:gravity="top"
                android:hint="Describa la falla encontrada"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="@color/blue_gray_900"
                android:textColorHint="@color/blue_gray_400" />

            <Button
                android:id="@+id/btnDictarDescripcionIncidencia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_labcare_button_secondary"
                android:text="Dictar descripción por voz"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Texto original de voz"
                    android:textColor="@color/blue_gray_900"
                    android:textStyle="bold" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieVoiceBadgeCrear"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Micrófono animado"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/lottie_voice" />
            </LinearLayout>

            <EditText
                android:id="@+id/edtTextoVozOriginalIncidenciaCrear"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_labcare_input"
                android:gravity="top"
                android:hint="Se llena automáticamente al dictar"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="@color/blue_gray_900"
                android:textColorHint="@color/blue_gray_400" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Prioridad"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spPrioridadIncidenciaCrear"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Estado"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spEstadoIncidenciaCrear"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Origen del registro"
                android:textColor="@color/blue_gray_900"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spOrigenIncidenciaCrear"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Latitud"
                        android:textColor="@color/blue_gray_900"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtLatitudIncidenciaCrear"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_labcare_input"
                        android:hint="13.7168"
                        android:inputType="numberDecimal|numberSigned"
                        android:padding="12dp"
                        android:textColor="@color/blue_gray_900"
                        android:textColorHint="@color/blue_gray_400" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Longitud"
                        android:textColor="@color/blue_gray_900"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtLongitudIncidenciaCrear"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_labcare_input"
                        android:hint="-89.2035"
                        android:inputType="numberDecimal|numberSigned"
                        android:padding="12dp"
                        android:textColor="@color/blue_gray_900"
                        android:textColorHint="@color/blue_gray_400" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnObtenerUbicacionIncidenciaCrear"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_labcare_button_secondary"
                    android:backgroundTint="@null"
                    android:text="Obtener ubicación GPS"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieGpsBadgeCrear"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="Ubicación animada"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/lottie_location" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGuardarIncidencia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_labcare_button_primary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Guardar incidencia"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLimpiarIncidencia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_labcare_button_secondary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Limpiar"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVolverCrearIncidencia"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_labcare_button_secondary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Volver"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
