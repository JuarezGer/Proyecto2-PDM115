<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_gray_50"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/bg_labcare_header"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visualizar incidencias"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTotalIncidencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Total: 0"
            android:textColor="@color/blue_gray_100"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/txtMensajeVisualizarIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/blue_gray_700"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Toque una incidencia para ver el detalle, leerla en voz alta o exportarla a PDF."
            android:textColor="@color/blue_gray_600"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/listIncidencias"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_labcare_card"
            android:divider="@color/blue_gray_100"
            android:dividerHeight="1dp"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnActualizarListaIncidencia"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_labcare_button_primary"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Actualizar lista"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverVisualizarIncidencia"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_labcare_button_secondary"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Volver"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
